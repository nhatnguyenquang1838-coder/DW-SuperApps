# Next.js / pnpm (app-local, projects/dw-observation)
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
.DS_Store

# Local env (never commit real values; .env.example is the contract)
.env
.env.local
.env.*.local

# Local Supabase CLI scaffold (supabase init/link state). Purely local dev
# tooling — contains no app code and must never be committed. The hosted
# project ref/org id live only under its gitignored .temp/ dir.
supabase/

*storybook.log
storybook-static

# Playwright run artifacts. The committed baselines live in
# e2e/*-snapshots/ and ARE tracked; only the throwaway run output is ignored.
# Without these two rules `git add -A` in a later task sweeps the whole report
# into the diff — which is how test output starts landing in production code.
playwright-report/
test-results/
/blob-report/
/playwright/.cache/
