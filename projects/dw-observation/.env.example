# M2 — DW Run Observatory live delivery (.env.example only; NO secrets committed).
# The browser Supabase Realtime binding (lib/supabaseRealtime.ts) and the
# Postgres durable store (lib/postgresEventStore.ts) read these names. Values
# are provided by the host platform at runtime. NO real credentials here.

# --- Durable Postgres projection event store (historical source of truth) ---
# Connection string used by the host-provided SqlQuery binding. Read-only SELECT.
# Example shape only; do not commit a real connection string.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/dw_observatory

# --- Supabase Realtime Broadcast (transport only, not canonical history) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: channel prefix for the run topic (default "observatory").
NEXT_PUBLIC_OBSERVATORY_REALTIME_TOPIC_PREFIX=observatory
