# ============================================================================
# M2 — DW Run Observatory live delivery env contract
# Browser-safe vs server-only is SPLIT. NEVER commit real values; this file is
# the contract only. A real .env is gitignored.
# ============================================================================

# ---- BROWSER-SAFE (NEXT_PUBLIC_*) : shipped to the browser, publishable only ----
# Used by the client-side Realtime Broadcast transport (lib/supabaseRealtime.ts).
# These are PUBLIC/publishable credentials — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# PRIMARY browser credential (publishable key). PREFERRED over the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# LEGACY fallback only — used when PUBLISHABLE_KEY is absent. Do not rely on it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional channel prefix (defaults to "observatory")
NEXT_PUBLIC_OBSERVATORY_REALTIME_TOPIC_PREFIX=observatory

# ---- M5 — local review data source (DW Run Observatory) ---------------------
# Controls how the M0-M4 surfaces are populated for local/human review.
#   mock  -> deterministic events derived from the in-repo fixtures; the whole
#            screen (M0..M4) renders consistently with ZERO Supabase calls.
#            This is the recommended mode for offline review.
#   real  -> genuine Supabase `projection_events` historical read; degrades to
#            PROJECTION_UNAVAILABLE when unconfigured/denied (never a mock LIVE).
# Unset/unknown defaults to `real`.
# No remote migration, apply, or Supabase write is performed by either mode.
OBSERVATORY_DATA_SOURCE=mock

# ---- SERVER-ONLY (never NEXT_PUBLIC_*, never shipped to the browser) ----------
# Used by the server-side historical read (lib/serverHistoricalRead.ts).
# DEFAULT credential is the publishable/read key (RLS-compatible). The service
# role key is OPTIONAL, server-only, and NOT required for G3 acceptance.
SUPABASE_URL=
# Default historical-read credential (publishable / RLS-compatible). Server-side
# usage only; never serialized to the client.
SUPABASE_READ_PUBLISHABLE_KEY=
# OPTIONAL, server-only, never required. Do not rely on it to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
