{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dw.superapps/schemas/store-api.schema.json",
  "title": "GWC Store API Request/Response Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "operation", "timestamp"],
  "properties": {
    "requestId": { "type": "string", "format": "uuid" },
    "operation": {
      "type": "string",
      "enum": ["store.load", "store.append", "store.lease", "store.pending", "store.readback"]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "key": { "type": "string", "minLength": 1, "description": "Store key" },
    "casToken": {
      "type": ["integer", "null"],
      "description": "CAS token from a prior read for conditional writes"
    },
    "payload": { "type": "object", "description": "Operation-specific payload" },
    "holderId": {
      "type": ["string", "null"],
      "description": "Lease holder node identifier"
    },
    "ttlSeconds": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 300,
      "description": "Lease time-to-live in seconds"
    },
    "actionId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Pending action identifier"
    },
    "fencingToken": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Current fencing token for the node"
    }
  }
}