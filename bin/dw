#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

case "${1:-}" in
  install|uninstall)
    action="$1"
    shift
    exec bash "$ROOT/scripts/install-dw.sh" "$action" "$@"
    ;;
esac

if [[ "${1:-}" == "python" && "${2:-}" == "init" ]]; then
  # This is a fail-fast preflight for non-interactive callers. A child
  # process cannot export functions into the caller's shell; Kiro sessions
  # must source scripts/kiro-python-session.sh first.
  # shellcheck source=../scripts/python-resolver.sh
  source "$ROOT/scripts/python-resolver.sh"
  dw_python_init
  dw_kiro_python --version
  exit $?
fi

if [[ "${1:-}" == "workspace" && "${2:-}" == "init" ]]; then
  # shellcheck source=../scripts/python-resolver.sh
  source "$ROOT/scripts/python-resolver.sh"
  dw_exec_python "$ROOT/scripts/dw_workspace_init.py" "$@"
  exit $?
fi

if [[ "${1:-}" == "project" ]]; then
  case "${2:-}" in
    list|info)
      # shellcheck source=../scripts/python-resolver.sh
      source "$ROOT/scripts/python-resolver.sh"
      dw_exec_python "$ROOT/scripts/dw_project_registry.py" "$@"
      exit $?
      ;;
    add)
      shift 2
      # shellcheck source=../scripts/python-resolver.sh
      source "$ROOT/scripts/python-resolver.sh"
      dw_exec_python "$ROOT/scripts/dw_project_add.py" "$@"
      exit $?
      ;;
  esac
fi

if [[ "${1:-}" == "orchestrator" ]]; then
  shift
  # shellcheck source=../scripts/python-resolver.sh
  source "$ROOT/scripts/python-resolver.sh"
  dw_exec_python "$ROOT/scripts/dw_orchestrator.py" "$@"
  exit $?
fi

if [[ "${1:-}" == "report" ]]; then
  shift
  # shellcheck source=../scripts/python-resolver.sh
  source "$ROOT/scripts/python-resolver.sh"
  dw_exec_python "$ROOT/scripts/dw_report.py" "$@"
  exit $?
fi

if [[ "${1:-}" == "gwc" ]]; then
  case "${2:-}" in
    report)
      shift 2
      # shellcheck source=../scripts/python-resolver.sh
      source "$ROOT/scripts/python-resolver.sh"
      dw_exec_python "$ROOT/scripts/gwc_report.py" "$@"
      exit $?
      ;;
  esac
fi

if [[ "${1:-}" == "power" ]]; then
  case "${2:-}" in
    install|configure|sanity|doctor|history|rollback|uninstall)
      shift
      # shellcheck source=../scripts/python-resolver.sh
      source "$ROOT/scripts/python-resolver.sh"
      dw_exec_python "$ROOT/scripts/dw_power_package.py" "$@"
      exit $?
      ;;
    cleanup)
      shift
      # shellcheck source=../scripts/python-resolver.sh
      source "$ROOT/scripts/python-resolver.sh"
      dw_exec_python "$ROOT/scripts/clean_power_setup.py" "$@"
      exit $?
      ;;
  esac
fi

if [[ "${1:-}" == "host" ]]; then
  case "${2:-}" in
    install|status)
      # shellcheck source=../scripts/python-resolver.sh
      source "$ROOT/scripts/python-resolver.sh"
      dw_exec_python "$ROOT/scripts/dw_workspace_dist.py" "$@"
      exit $?
      ;;
  esac
fi

# shellcheck source=../scripts/python-resolver.sh
source "$ROOT/scripts/python-resolver.sh"
dw_exec_python "$ROOT/scripts/dw_entry.py" "$@"
