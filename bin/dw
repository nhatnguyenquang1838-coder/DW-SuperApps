#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

case "${1:-}" in
  install|uninstall)
    action="$1"
    shift
    exec bash "$ROOT/scripts/install-dw.sh" "$action" "$@"
    ;;
esac

if [[ "${1:-}" == "workspace" && "${2:-}" == "init" ]]; then
  # shellcheck source=../scripts/python-resolver.sh
  source "$ROOT/scripts/python-resolver.sh"
  dw_exec_python "$ROOT/scripts/dw_project_registry.py" "$@"
  exit $?
fi

if [[ "${1:-}" == "project" ]]; then
  case "${2:-}" in
    list|info|add)
      # shellcheck source=../scripts/python-resolver.sh
      source "$ROOT/scripts/python-resolver.sh"
      dw_exec_python "$ROOT/scripts/dw_project_registry.py" "$@"
      exit $?
      ;;
  esac
fi

if [[ "${1:-}" == "power" ]]; then
  case "${2:-}" in
    install|configure|doctor|history|rollback|uninstall)
      shift
      # shellcheck source=../scripts/python-resolver.sh
      source "$ROOT/scripts/python-resolver.sh"
      dw_exec_python "$ROOT/scripts/dw_power_package.py" "$@"
      exit $?
      ;;
    prompt)
      # shellcheck source=../scripts/python-resolver.sh
      source "$ROOT/scripts/python-resolver.sh"
      dw_exec_python "$ROOT/scripts/dw_workspace_dist.py" "$@"
      exit $?
      ;;
  esac
fi

if [[ "${1:-}" == "host" ]]; then
  case "${2:-}" in
    install|status)
      # shellcheck source=../scripts/python-resolver.sh
      source "$ROOT/scripts/python-resolver.sh"
      dw_exec_python "$ROOT/scripts/dw_workspace_dist.py" "$@"
      exit $?
      ;;
  esac
fi

# shellcheck source=../scripts/python-resolver.sh
source "$ROOT/scripts/python-resolver.sh"
dw_exec_python "$ROOT/scripts/dw_entry.py" "$@"
