{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dw-superapps/taskcontroller/schemas/review_result.schema.json",
  "title": "ReviewResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "target_ref",
    "verdict",
    "reviewer"
  ],
  "properties": {
    "review_id": {
      "$ref": "https://dw-superapps/taskcontroller/schemas/common.schema.json#/$defs/Id"
    },
    "target_ref": {
      "$ref": "https://dw-superapps/taskcontroller/schemas/common.schema.json#/$defs/NonEmptyString"
    },
    "verdict": {
      "$ref": "https://dw-superapps/taskcontroller/schemas/common.schema.json#/$defs/ReviewVerdict"
    },
    "reviewer": {
      "$ref": "https://dw-superapps/taskcontroller/schemas/common.schema.json#/$defs/NonEmptyString"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "score": {
      "type": "number"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan_version": {
      "$ref": "https://dw-superapps/taskcontroller/schemas/common.schema.json#/$defs/Version"
    },
    "run_version": {
      "$ref": "https://dw-superapps/taskcontroller/schemas/common.schema.json#/$defs/Version"
    }
  }
}
