{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dw-superapps/taskcontroller/schemas/mailbox_v2.schema.json",
  "title": "TaskController Mailbox v2 Event",
  "description": "Normative, transport-neutral TaskController mailbox/v2 envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "message_id",
    "run_id",
    "node_id",
    "seq",
    "correlation_id",
    "direction",
    "message_type",
    "producer",
    "recipient",
    "logical_contract",
    "attempt",
    "execution_identity",
    "source_manifest",
    "standards_profile",
    "payload",
    "provenance",
    "idempotency_key",
    "digest"
  ],
  "properties": {
    "protocol": {
      "const": "dw.taskcontroller.mailbox/v2"
    },
    "message_id": {
      "$ref": "#/$defs/id"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "node_id": {
      "$ref": "#/$defs/id"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "correlation_id": {
      "$ref": "#/$defs/id"
    },
    "direction": {
      "enum": [
        "controller_to_executor",
        "executor_to_controller"
      ]
    },
    "message_type": {
      "enum": [
        "execution_request",
        "execution_progress",
        "child_result",
        "review_finding",
        "mixer_result",
        "terminal_result"
      ]
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "recipient": {
      "$ref": "#/$defs/recipient"
    },
    "logical_contract": {
      "$ref": "#/$defs/logical_contract"
    },
    "attempt": {
      "$ref": "#/$defs/attempt"
    },
    "execution_identity": {
      "$ref": "#/$defs/execution_identity"
    },
    "source_manifest": {
      "$ref": "#/$defs/source_manifest"
    },
    "standards_profile": {
      "$ref": "#/$defs/standards_profile"
    },
    "payload": {
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "$comment": "Result is required structurally; request/progress messages may carry null."
    },
    "idempotency_key": {
      "$ref": "#/$defs/id"
    },
    "digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "message_type": {
            "enum": [
              "child_result",
              "review_finding",
              "mixer_result",
              "terminal_result"
            ]
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "$ref": "#/$defs/result"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "non_empty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "actor_id",
        "role"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/id"
        },
        "actor_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "controller",
            "executor",
            "child",
            "reviewer",
            "mixer",
            "system"
          ]
        }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "agent_instance"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/non_empty"
        },
        "agent_instance": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_actions",
        "denied_actions",
        "writable_targets",
        "source_roots",
        "max_children",
        "max_parallel",
        "max_depth"
      ],
      "properties": {
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        },
        "denied_actions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        },
        "writable_targets": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        },
        "source_roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        },
        "max_children": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "replan_required_when": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        },
        "time_budget_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 3600
        },
        "token_budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "logical_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "plan_version",
        "contract_digest",
        "boundary_digest",
        "source_digest",
        "objective",
        "scope",
        "acceptance_criteria",
        "standards_profile_ref",
        "source_manifest_ref"
      ],
      "properties": {
        "contract_id": {
          "$ref": "#/$defs/id"
        },
        "plan_version": {
          "$ref": "#/$defs/id"
        },
        "contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "boundary_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_digest": {
          "$ref": "#/$defs/digest"
        },
        "objective": {
          "$ref": "#/$defs/non_empty"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        },
        "standards_profile_ref": {
          "$ref": "#/$defs/non_empty"
        },
        "source_manifest_ref": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "boundary_digest",
        "attempt_number",
        "lease_generation",
        "fencing_token",
        "agent_instance",
        "lease_expires_at"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/id"
        },
        "boundary_digest": {
          "$ref": "#/$defs/digest"
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 0
        },
        "fencing_token": {
          "$ref": "#/$defs/non_empty"
        },
        "agent_instance": {
          "$ref": "#/$defs/id"
        },
        "lease_expires_at": {
          "$ref": "#/$defs/non_empty"
        }
      }
    },
    "execution_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "node_id",
        "plan_version",
        "contract_digest",
        "boundary_digest",
        "source_digest",
        "attempt_id",
        "lease_generation",
        "fencing_token"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "node_id": {
          "$ref": "#/$defs/id"
        },
        "plan_version": {
          "$ref": "#/$defs/id"
        },
        "contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "boundary_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_digest": {
          "$ref": "#/$defs/digest"
        },
        "attempt_id": {
          "$ref": "#/$defs/id"
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 0
        },
        "fencing_token": {
          "$ref": "#/$defs/non_empty"
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "path",
        "blob_digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "path": {
          "$ref": "#/$defs/non_empty"
        },
        "blob_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "source_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_version",
        "digest",
        "sources"
      ],
      "properties": {
        "manifest_version": {
          "$ref": "#/$defs/non_empty"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        }
      }
    },
    "standards_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "version",
        "digest"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "agent_instance",
        "status",
        "source_refs",
        "evidence_refs",
        "result_digest"
      ],
      "properties": {
        "origin": {
          "enum": [
            "controller",
            "executor",
            "child",
            "reviewer",
            "mixer",
            "system"
          ]
        },
        "parent_message_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "child_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "lens": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "agent_instance": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "REQUESTED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "STALE",
            "REJECTED",
            "NEEDS_CLARIFICATION"
          ]
        },
        "source_refs": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        },
        "result_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "category",
        "lens",
        "claim",
        "evidence_refs",
        "recommendation",
        "reviewer",
        "disposition"
      ],
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/id"
        },
        "severity": {
          "enum": [
            "critical",
            "major",
            "minor",
            "info"
          ]
        },
        "category": {
          "$ref": "#/$defs/non_empty"
        },
        "lens": {
          "$ref": "#/$defs/non_empty"
        },
        "claim": {
          "$ref": "#/$defs/non_empty"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        },
        "recommendation": {
          "$ref": "#/$defs/non_empty"
        },
        "reviewer": {
          "$ref": "#/$defs/id"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "disposition": {
          "enum": [
            "OPEN",
            "ACCEPTED",
            "REJECTED",
            "DEFERRED",
            "ESCALATED"
          ]
        },
        "conflict_group": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "boundary_digest",
        "result_digest",
        "artifact_refs",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "NEEDS_CLARIFICATION",
            "STALE",
            "REJECTED"
          ]
        },
        "boundary_digest": {
          "$ref": "#/$defs/digest"
        },
        "result_digest": {
          "$ref": "#/$defs/digest"
        },
        "artifact_refs": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/non_empty"
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    }
  }
}
