{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dw-superapps.local/schemas/task-controller-plan.schema.json",
  "title": "DW SuperApps TaskController Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "title",
    "objective",
    "subtasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "subtasks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/subtask"
      }
    }
  },
  "$defs": {
    "subtask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objective",
        "allowedWork",
        "expectedOutput",
        "reportRequirement",
        "afterReport"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "allowedWork": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedOutput": {
          "type": "string",
          "minLength": 1
        },
        "reportRequirement": {
          "type": "string",
          "minLength": 1
        },
        "afterReport": {
          "enum": [
            "CONTINUE",
            "WAIT_CONTROLLER",
            "TERMINAL"
          ]
        }
      }
    }
  }
}
