{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dw.superapps/schemas/bmad-procedure-registry.schema.json",
  "title": "BMAD Procedure Registry",
  "description": "Registry of BMAD procedure adapters for P4. Defines which procedures are available, their inputs/outputs, timeouts, retry policies, and authority boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "dw.superapps/v1"
    },
    "kind": {
      "const": "BmadProcedureRegistry"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["procedures", "permissionModelRef", "authorityBoundary"],
      "properties": {
        "procedures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/procedure" }
        },
        "permissionModelRef": {
          "type": "string",
          "description": "Reference to the permission model schema that defines allowed/prohibited actions for each procedure."
        },
        "authorityBoundary": {
          "$ref": "#/$defs/authorityBoundary"
        },
        "idempotencyPolicy": {
          "$ref": "#/$defs/idempotencyPolicy"
        },
        "provenanceContractRef": {
          "type": "string",
          "description": "Reference to the ownership/provenance contract (SCRUM-116) that all procedure outputs must comply with."
        }
      }
    }
  },
  "$defs": {
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedureId",
        "version",
        "category",
        "inputs",
        "outputs",
        "permissionLevel"
      ],
      "properties": {
        "procedureId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "category": {
          "enum": [
            "analysis",
            "planning",
            "implementation",
            "review",
            "validation"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "permissionLevel": {
          "enum": ["readAnalysis", "boundedWrite", "prohibited"]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 0,
          "default": 3600
        },
        "retryPolicy": {
          "$ref": "#/$defs/retryPolicy"
        },
        "executionMode": {
          "enum": ["exclusive", "shared"],
          "default": "shared",
          "description": "Whether the procedure requires exclusive access (lease/fencing/CAS) or can run in parallel."
        },
        "gateRecommendations": {
          "type": "boolean",
          "default": false,
          "description": "Whether this procedure may produce gate change recommendations (read-only evidence, never auto-approve)."
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "backoffType": {
          "enum": ["exponential", "fixed", "none"],
          "default": "none"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        }
      }
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateApproval",
        "canonicalState",
        "scopeExpansion",
        "projectionWrites"
      ],
      "properties": {
        "gateApproval": {
          "type": "string",
          "description": "BMAD cannot approve G2/G4/G5/G6. Gate transitions are performed by GWC only."
        },
        "canonicalState": {
          "type": "string",
          "description": "BMAD cannot alter .gwc canonical state."
        },
        "scopeExpansion": {
          "type": "string",
          "description": "BMAD cannot expand scope without explicit GWC authorization."
        },
        "projectionWrites": {
          "type": "string",
          "description": "BMAD cannot perform Jira/Notion/Slack projection writes."
        }
      }
    },
    "idempotencyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "duplicateHandling"],
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" },
          "default": ["procedureId", "targetSha", "gwcScopeHash"],
          "description": "Fields that compose the idempotency key scope."
        },
        "duplicateHandling": {
          "type": "string",
          "enum": ["reject", "returnCached", "resume"],
          "default": "reject",
          "description": "How to handle requests with duplicate idempotency keys."
        }
      }
    }
  }
}
