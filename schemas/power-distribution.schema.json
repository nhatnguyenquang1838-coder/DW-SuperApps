{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dw.superapps/schemas/power-distribution.schema.json",
  "title": "DW Power Distribution Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "dw.superapps/v1"},
    "kind": {"const": "PowerDistribution"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "package", "include", "runtime"],
      "properties": {
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dashboard": {"type": "boolean", "default": false}
          }
        },
        "source": {"type": "object"},
        "package": {"type": "object"},
        "include": {"type": "array"},
        "exclude": {"type": "array"},
        "forbidden": {"type": "object"},
        "runtime": {"type": "object"}
      }
    }
  }
}
