{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dw.superapps/schemas/power-compatibility-lock.schema.json",
  "title": "DW SuperApps Power Compatibility Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkedAt",
    "powers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "checkedAt": {
      "type": "string",
      "minLength": 1
    },
    "powers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceRepository",
          "providerHeadSha",
          "distributionRepository",
          "distributionRef",
          "publishedSourceSha",
          "packageVersion",
          "runtimeDataRoot",
          "entrypoints",
          "guidanceMode",
          "status"
        ],
        "properties": {
          "sourceRepository": {
            "type": "string",
            "pattern": "^[^/\\s]+/[^/\\s]+$"
          },
          "providerHeadSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "distributionRepository": {
            "type": "string",
            "pattern": "^[^/\\s]+/[^/\\s]+$"
          },
          "distributionRef": {
            "type": "string",
            "minLength": 1
          },
          "publishedSourceSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "packageVersion": {
            "type": "string",
            "minLength": 1
          },
          "runtimeDataRoot": {
            "type": "string",
            "pattern": "^\\.[a-z0-9][a-z0-9._-]*$"
          },
          "entrypoints": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "guidanceMode": {
            "enum": [
              "legacy-optional",
              "required"
            ]
          },
          "status": {
            "enum": [
              "CURRENT",
              "PROVIDER_SOURCE_AHEAD"
            ]
          },
          "publicationState": {
            "enum": [
              "release-and-branch",
              "distribution-branch"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
